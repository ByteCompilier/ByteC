; Wave loading, validation and export
MODULE audio
AUDIO_INIT
; Place audio.wav beside the program or adjust the filename.
AUDIO_LOAD_WAVE audio.wav
AUDIO_IS_WAVE_VALID 0
PR a
AUDIO_EXPORT_WAVE 0 C:/Users/1/CLionProjects/ByteC/test.wav
AUDIO_EXPORT_WAVE_AS_CODE 0 output_wave.h
AUDIO_UNLOAD_WAVE 0
AUDIO_CLOSE
